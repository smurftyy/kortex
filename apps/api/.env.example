# Kortex API — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (server-side only, keep secret)
SUPABASE_SERVICE_KEY=your-service-role-key

# Secret used to verify Supabase-issued JWTs
SUPABASE_JWT_SECRET=your-jwt-secret

# Postgres connection string (Supabase)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Redis / ARQ queue (optional — defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379
