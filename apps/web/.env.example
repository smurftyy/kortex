# Kortex web — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL + anon (public) key — same project the API uses.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the Next dev/prod server proxies /api/v1/* to (FastAPI backend).
# Server-side only — not exposed to the browser.
API_PROXY_TARGET=http://localhost:8000

# Optional: override the browser-side API base. Defaults to same-origin
# /api/v1 (proxied via next.config.mjs rewrites, avoiding CORS).
# NEXT_PUBLIC_API_BASE_URL=/api/v1
